# Copy to .env for local development and replace values as needed.
# Never commit the local .env file.

MYSQL_APP_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password
DB_PASSWORD=change-me-db-password
APP_JWT_SECRET=change-me-jwt-secret-for-local-only

MINIO_ROOT_PASSWORD=change-me-minio-secret
APP_STORAGE_MINIO_ACCESS_KEY=contract_app
APP_STORAGE_MINIO_SECRET_KEY=change-me-minio-secret

# Optional: leave empty to keep the application in manual-review mode.
APP_AI_API_KEY=
