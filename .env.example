# Copy to .env for local development and replace values as needed.
# Never commit the local .env file.

MYSQL_DATABASE=contract_lifecycle
MYSQL_USER=contract_app
MYSQL_APP_PASSWORD=development-db-password
MYSQL_ROOT_PASSWORD=development-root-password
DB_URL=jdbc:mysql://localhost:3307/contract_lifecycle?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=contract_app
DB_PASSWORD=development-db-password
APP_JWT_SECRET=change-me-jwt-secret-for-local-only

RABBITMQ_DEFAULT_USER=contract_app
RABBITMQ_DEFAULT_PASS=development-rabbit-password
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=contract_app
SPRING_RABBITMQ_PASSWORD=development-rabbit-password
MINIO_ROOT_USER=contract_app
MINIO_ROOT_PASSWORD=development-minio-password
APP_STORAGE_MINIO_ACCESS_KEY=contract_app
APP_STORAGE_MINIO_SECRET_KEY=development-minio-password
APP_STORAGE_PROVIDER=local
APP_MESSAGING_MODE=database
APP_AI_QDRANT_URL=http://localhost:6333

# Optional: leave empty to keep the application in manual-review mode.
APP_AI_API_KEY=
