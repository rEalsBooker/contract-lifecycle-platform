DB_URL=jdbc:mysql://localhost:3306/contract_lifecycle?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=contract_app
DB_PASSWORD=contract_app_dev
APP_JWT_SECRET=replace-this-with-a-random-secret-at-least-32-bytes-long

# 默认保持数据库 Outbox 本地派发；安装并启动 RabbitMQ 后再改为 rabbit。
APP_MESSAGING_MODE=database

# 使用 Docker MinIO 时切换为 minio；local 模式保留本地私有文件存储。
APP_STORAGE_PROVIDER=local
APP_STORAGE_MINIO_ENDPOINT=http://localhost:9000
APP_STORAGE_MINIO_ACCESS_KEY=contract_app
APP_STORAGE_MINIO_SECRET_KEY=contract_app_dev_minio
APP_STORAGE_MINIO_BUCKET=contract-private-files

# 未配置真实模型时保持 none，系统明确进入人工审阅模式，不生成模拟 AI 结果。
APP_AI_PROVIDER=qwen
APP_AI_API_KEY=
APP_AI_MODEL_NAME=qwen3.8-flash
APP_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
APP_AI_TIMEOUT_SECONDS=120

# Embedding RAG / LangChain4j Tool Calling Agent
APP_AI_RAG_ENABLED=true
APP_AI_EMBEDDING_MODEL_NAME=text-embedding-v4
APP_AI_EMBEDDING_DIMENSIONS=1024
APP_AI_RAG_CHUNK_SIZE=1200
APP_AI_RAG_CHUNK_OVERLAP=200
APP_AI_RAG_TOP_K=4
APP_AI_RAG_MIN_SCORE=0.55
APP_AI_RAG_FALLBACK_ENABLED=true
APP_AI_QDRANT_URL=http://localhost:6333
APP_AI_QDRANT_COLLECTION=contract_chunks
APP_AI_AGENT_ENABLED=true
